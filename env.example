# Copy this to .env before running the backend. Never commit .env to git.

# ── Storage ───────────────────────────────────────────────────────────────────
# local: files stored under DATA_DIR on disk (prototype default)
# s3:    swap storage backend without changing pipeline code
STORAGE_BACKEND=local
DATA_DIR=/data/jobs

# Path where audio-separator downloads model checkpoints (~200 MB on first run)
SEPARATOR_MODEL_DIR=/data/models

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for prototype. Swap to postgres://user:pass@host/db for production.
DATABASE_URL=sqlite:///./jobs.db

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_GB=2

# ── External services (wired in later stages) ─────────────────────────────────
# Stage 5: TTS + lipsync
# ELEVENLABS_API_KEY=

# Stage 3/4: Transcription + translation via Gemini on Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
